SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,YOUR-SHOP.example
CSRF_TRUSTED_ORIGINS=https://YOUR-SHOP.example
PUBLIC_BASE_URL=https://YOUR-SHOP.example

# PostgreSQL is required for production row locking. With DEBUG=False the app
# refuses to start if DB_NAME is empty. Use a strong DB_PASSWORD.
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# ALLOW_SQLITE=True  # local test runs only, never in production

# Where uploaded product photos are stored. Use a persistent disk/volume in production.
# MEDIA_ROOT=/data/media

PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
# Legacy API key used only for refund authentication; never a public key.
PAYMOB_API_KEY=
PAYMOB_NOTIFICATION_URL=https://YOUR-SHOP.example/api/payments/webhook/
PAYMOB_REDIRECTION_URL=https://YOUR-SHOP.example/

# Email is OPTIONAL: the shop sends no customer email. These are only for operator
# alerts (server errors, payments needing attention). Leave ADMIN_EMAILS empty
# unless the mail settings below really work.
DEFAULT_FROM_EMAIL=shop@YOUR-SHOP.example
SERVER_EMAIL=errors@YOUR-SHOP.example
ADMIN_EMAILS=
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Error reporting to GlitchTip (https://glitchtip.com). Leave GLITCHTIP_DSN empty to
# switch it off. Copy the DSN from your GlitchTip project (Project > Settings).
# Verify with: python manage.py glitchtip_test
GLITCHTIP_DSN=
# GLITCHTIP_ENVIRONMENT=production
# GLITCHTIP_RELEASE=

# Product analytics with PostHog (https://posthog.com). Leave POSTHOG_API_KEY empty to
# switch it off. Use the project API key (starts with phc_) from Project settings.
# Verify with: python manage.py posthog_test
POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com   (EU region: https://eu.i.posthog.com)
# POSTHOG_ENVIRONMENT=production

# BEHIND_PROXY=True # only with a trusted proxy that overwrites X-Forwarded-Proto
# SECURE_HSTS_SECONDS=31536000 # after confirming HTTPS

# Only for private TCP Gunicorn behind Nginx that overwrites X-Real-IP.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Public seller/contact details: complete and review before accepting public orders.
SHOP_SUPPORT_EMAIL=
SHOP_LEGAL_NAME=
SHOP_BUSINESS_ADDRESS=
SHOP_PHONE=
SHOP_REGISTRATION_DETAILS=
